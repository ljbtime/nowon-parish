rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 조회수만 1 올리는 수정 (로그인 없이도 허용)
    function isViewIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.get('views', 0) + 1;
    }

    // 공지사항 - 누구나 읽기, 관리자만 쓰기
    match /notices/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isViewIncrement();
    }

    // 자유게시판 - 누구나 읽기, 로그인 회원 작성(작성자는 본인으로만), 본인 또는 관리자만 수정/삭제
    match /posts/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin() || isViewIncrement() ||
        (request.auth != null && resource.data.authorUid == request.auth.uid
         && request.resource.data.authorUid == request.auth.uid);
      allow delete: if request.auth != null &&
        (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // 갤러리 - 누구나 읽기, 관리자만 쓰기
    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 미사 시간 - 누구나 읽기, 관리자만 쓰기
    match /massSchedule/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 사제단/수녀 - 누구나 읽기, 관리자만 쓰기
    match /clergy/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 회원 정보 - 본인만 읽기/쓰기, 관리자는 전체 읽기
    match /users/{userId} {
      allow read: if request.auth != null &&
                    (request.auth.uid == userId || request.auth.token.admin == true);
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }

    // 아이디 → 이메일 연결 (로그인·아이디 중복확인용)
    // 정확한 아이디로 한 건씩만 조회 가능, 목록 조회 불가. 생성은 본인 것만, 덮어쓰기 불가.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email']);
      allow delete: if request.auth != null &&
        (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
    }
  }
}
